# ReSource AI - Backend Environment Template

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
# You can supply either a full connection string or individual credentials
DATABASE_URL=postgresql://localhost:5432/resource_ai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resource_ai
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Authentication & Security
JWT_SECRET=resource_ai_jwt_secure_development_secret_key_2026
JWT_EXPIRES_IN=7d

# Cloudinary Media Storage (Optional for local dev - fallback storage provided)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Python Recommendation Microservice
MATCHER_SERVICE_URL=http://localhost:8000
MATCHER_TIMEOUT_MS=1500
