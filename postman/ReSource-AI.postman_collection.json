              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Surplus Pine Wood Offcuts\",\n  \"material_category\": \"wood\",\n  \"material_type\": \"Pine Battens\",\n  \"condition\": \"Good\",\n  \"quantity_description\": \"20 pieces of 1-meter lengths\",\n  \"description\": \"Clean dry untreated pine wood scraps from architectural model making workshop.\",\n  \"city\": \"Bengaluru\",\n  \"image_url\": \"https://images.unsplash.com/photo-1546484396-fb3fc6f95f98?auto=format&fit=crop&w=600&q=80\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/listings",
              "host": ["{{baseUrl}}"],
              "path": ["listings"]
            }
          }
        },
        {
          "name": "Update Material Listing (Owner Only)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity_description\": \"15 pieces remaining\",\n  \"condition\": \"Like New\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "{{listingId}}"]
            }
          }
        },
        {
          "name": "Soft Archive Listing (Owner Only)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "{{listingId}}"]
            }
          }
        },
        {
          "name": "Get Current Donor's Listings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/listings/my/all",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "my", "all"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Media Uploads",
      "item": [
