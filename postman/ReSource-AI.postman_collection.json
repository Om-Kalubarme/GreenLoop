                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/uploads/image",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "image"]
            }
          }
