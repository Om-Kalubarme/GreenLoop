      ]
    },
    {
      "name": "5. Reuse Proposals & Workflow",
      "item": [
        {
          "name": "Express Interest in Listing (Recipient)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello Anita! I run an art studio for underprivileged children and we would love to reuse these boxes for storage and school painting projects. Can collect this Saturday.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}/interests",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "{{listingId}}", "interests"]
            }
          }
        },
        {
          "name": "Get Interests for Listing (Donor Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/listings/{{listingId}}/interests",
              "host": ["{{baseUrl}}"],
              "path": ["listings", "{{listingId}}", "interests"]
            }
          }
        },
        {
          "name": "Get User's Sent & Received Interests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/interests/my",
              "host": ["{{baseUrl}}"],
              "path": ["interests", "my"]
            }
          }
        },
        {
          "name": "Update Interest Status (Accept / Decline)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/interests/{{interestId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["interests", "{{interestId}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Explainable AI Recommendations",
      "item": [
        {
          "name": "Get Recommendations for Recipient",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/recommendations?top_n=10",
              "host": ["{{baseUrl}}"],
              "path": ["recommendations"],
              "query": [
                {
                  "key": "top_n",
                  "value": "10"
                }
              ]
            },
            "description": "Returns top ranked listings scored via 100-point rule-based formula or Python scikit-learn TF-IDF matcher with human-readable explanation reason."
